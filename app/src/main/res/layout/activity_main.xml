<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/gradient_background"
    android:padding="24dp">

    <!-- Tarjeta principal de Login -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <!-- Icono de seguridad -->
            <ImageView
                android:id="@+id/ivSecurityIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_lock_idle_lock"
                android:contentDescription="Icono de Seguridad"
                android:layout_marginBottom="24dp"
                app:tint="@color/primary" />

            <!-- Titulo principal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auth0 Universal Login"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"
                android:gravity="center" />

            <!-- Descripcion -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicia sesión usando la pasarela segura de Auth0 para continuar a la aplicación principal."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="32dp"
                android:lineSpacingExtra="4sp" />

            <!-- Boton Iniciar Sesion -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Iniciar Sesión"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:elevation="4dp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Texto inferior -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Demo de Consumo de APIs - Auxiliatura"
        android:textSize="12sp"
        android:textColor="#B2FFFFFF"
        android:layout_marginTop="32dp"
        android:gravity="center" />

</LinearLayout>
